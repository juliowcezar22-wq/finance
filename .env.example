# ============================================================
# TEMPLATE do ambiente de DESENVOLVIMENTO deste projeto paralelo
# Copie para `.env` e preencha com o banco de DEV (Supabase novo).
#
#   cp .env.example .env
#
# ⚠️ NUNCA coloque aqui as credenciais do banco de PRODUÇÃO.
#    Produção vive apenas no projeto/Vercel original.
# ============================================================

# Identifica o ambiente. Os scripts de banco deste repo RECUSAM
# rodar se APP_ENV for "production" (guarda anti-acidente).
APP_ENV="development"

# ===== Banco (Supabase — projeto de DEV) =====
# Supabase → seu projeto DEV → Settings → Database → Connection string
# POSTGRES_PRISMA_URL      = conexão COM POOL (porta 6543, usada pelo app)
# POSTGRES_URL_NON_POOLING = conexão DIRETA (porta 5432, migrations/db push)
POSTGRES_PRISMA_URL="postgres://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
POSTGRES_URL_NON_POOLING="postgres://USER:PASSWORD@HOST:5432/postgres"

# ===== Sessão =====
# Opcional em dev (há fallback), OBRIGATÓRIO em produção.
# Gere um valor com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SESSION_SECRET="troque-por-um-segredo-de-32+chars"
