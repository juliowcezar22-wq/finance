# ============================================================
# TEMPLATE do ambiente de TESTES
# Copie para `.env.test` e preencha com o banco de TESTES
# (projeto Supabase próprio, separado de dev e de prod).
#
#   cp .env.test.example .env.test
#
# Este banco é DESCARTÁVEL: os scripts db:test:* podem resetá-lo
# a qualquer momento. Nunca aponte para dev nem para prod.
# ============================================================

APP_ENV="test"

# ===== Banco (Supabase — projeto de TESTES) =====
POSTGRES_PRISMA_URL="postgres://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
POSTGRES_URL_NON_POOLING="postgres://USER:PASSWORD@HOST:5432/postgres"

# ===== Segredos (OBRIGATÓRIOS — a suíte de testes não sobe sem eles) =====
# SESSION_SECRET precisa ter no mínimo 32 caracteres.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="troque-por-um-segredo-de-32+chars"
CRON_SECRET="troque-por-um-segredo-forte"
