{
  "name": "bugia-finance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run tests/security",
    "db:baseline": "tsx scripts/with-env.ts .env -- prisma migrate resolve --applied 0_init",
    "db:migrate": "tsx scripts/with-env.ts .env -- prisma migrate dev",
    "db:migrate:deploy": "tsx scripts/with-env.ts .env -- prisma migrate deploy",
    "db:push": "tsx scripts/with-env.ts .env -- prisma db push",
    "db:seed": "tsx scripts/with-env.ts .env -- tsx prisma/seed.ts",
    "db:studio": "tsx scripts/with-env.ts .env -- prisma studio",
    "db:diagnose": "tsx scripts/with-env.ts .env -- tsx scripts/diagnose-data.ts",
    "db:fix-imported": "tsx scripts/with-env.ts .env -- tsx scripts/fix-imported-data.ts",
    "db:multiuser": "tsx scripts/with-env.ts .env -- tsx scripts/multiuser-migrate-data.ts",
    "db:backup": "tsx scripts/with-env.ts .env -- tsx scripts/backup-json.ts",
    "db:recompute-installments": "tsx scripts/with-env.ts .env -- tsx scripts/recompute-installments.ts",
    "db:encrypt-secrets": "tsx scripts/with-env.ts .env -- tsx scripts/encrypt-secrets.ts",
    "db:test:backup": "tsx scripts/with-env.ts .env.test -- tsx scripts/backup-json.ts",
    "db:test:push": "tsx scripts/with-env.ts .env.test -- prisma db push",
    "db:test:migrate:deploy": "tsx scripts/with-env.ts .env.test -- prisma migrate deploy",
    "db:test:seed": "tsx scripts/with-env.ts .env.test -- tsx prisma/seed.ts",
    "db:test:reset": "tsx scripts/with-env.ts .env.test -- prisma migrate reset --force",
    "db:test:studio": "tsx scripts/with-env.ts .env.test -- prisma studio",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "next lint && tsc --noEmit && prettier --check ."
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/pdf-parse": "^1.1.5",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.12.0",
    "next": "14.2.18",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
